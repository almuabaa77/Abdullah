# Public Firebase Web SDK configuration. Configure Phone Auth and the deployment domain in Firebase.
# FIREBASE_WEB_CONFIG={"apiKey":"...","authDomain":"PROJECT.firebaseapp.com","projectId":"PROJECT","appId":"..."}
FIREBASE_WEB_CONFIG=
# UID of the verified initial administrator. Configure this on the server.
BOOTSTRAP_UID=

# Hostinger Node.js. Supply either DATABASE_URL or all four DB connection settings.
DATABASE_URL=
DB_HOST=
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASSWORD=

# Agora RTC. Set the flag only after Co-host token authentication is enabled in Agora Console.
AGORA_APP_ID=
AGORA_APP_CERTIFICATE=
AGORA_CUSTOMER_ID=
AGORA_CUSTOMER_SECRET=
AGORA_COHOST_AUTH_ENABLED=

# Optional server-side key for the administrator's AI icon generator.
OPENAI_API_KEY=
