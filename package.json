{
  "name": "waslah",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env server.mjs",
    "dev": "node --env-file-if-exists=.env --watch server.mjs",
    "test": "node --test tests/*.test.mjs",
    "build:firebase": "esbuild firebase-browser.js --bundle --format=esm --platform=browser --minify --outfile=public/assets/firebase-auth.js",
    "prestart": "npm run build:firebase",
    "predev": "npm run build:firebase",
    "check:firebase": "node check-firebase.mjs",
    "backup": "node --env-file-if-exists=.env backup.mjs"
  },
  "dependencies": {
    "@fontsource/ibm-plex-sans-arabic": "^5.2.8",
    "firebase-admin": "^14.5.1",
    "lucide": "^0.468.0"
  },
  "devDependencies": {
    "@firebase/app": "0.16.7",
    "@firebase/auth": "1.13.11",
    "esbuild": "^0.28.2"
  }
}
